# Gateway integration environment file
# Copy or source this file for local integration testing.
# Do not commit secrets or production credentials.

PESAGUARD_ENVIRONMENT=development
PESAGUARD_APP_NAME=PesaGuard API Gateway
PESAGUARD_VERSION=0.1.0
PESAGUARD_DEBUG=true
PESAGUARD_HOST=0.0.0.0
PESAGUARD_PORT=8000
PESAGUARD_LOG_LEVEL=DEBUG
PESAGUARD_DOCS_ENABLED=true
PESAGUARD_ALLOWED_ORIGINS=["http://localhost:3000"]
PESAGUARD_ALLOWED_HOSTS=["localhost","127.0.0.1"]
PESAGUARD_JWT_SECRET=integration-test-secret-key-1234567890abcdef
PESAGUARD_JWT_ALGORITHM=HS256
PESAGUARD_JWT_AUDIENCE=pesaguard-api
PESAGUARD_JWT_ISSUER=pesaguard
PESAGUARD_API_KEY_HASHES=[]
PESAGUARD_API_KEY_SCOPES={}
PESAGUARD_RATE_LIMIT_REQUESTS=120
PESAGUARD_RATE_LIMIT_WINDOW_SECONDS=60
PESAGUARD_RATE_LIMIT_BURST=120
PESAGUARD_REQUEST_MAX_BYTES=1048576
PESAGUARD_REDIS_URL=redis://redis:6379/0
PESAGUARD_DATABASE_URL=postgresql+asyncpg://pesaguard:pesaguard@postgres:5432/pesaguard
PESAGUARD_OTEL_ENDPOINT=
PESAGUARD_AUTH_SERVICE_URL=http://auth-service:8080
PESAGUARD_PAYMENTS_SERVICE_URL=http://payment-service:8080
PESAGUARD_TRANSACTIONS_SERVICE_URL=http://transaction-service:8080
PESAGUARD_REPORTS_SERVICE_URL=http://reporting-service:8080
PESAGUARD_AUDIT_SERVICE_URL=http://audit-service:8080
PESAGUARD_UPSTREAM_TIMEOUT_SECONDS=10
PESAGUARD_UPSTREAM_MAX_RETRIES=2
PESAGUARD_ROUTE_CONFIG_PATH=./app/config/routes.yaml
